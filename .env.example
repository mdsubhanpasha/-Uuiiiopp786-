# Environment Configuration for CodeGuard AI Enterprise

# GitHub Personal Access Token (Requires 'repo' scope for private repositories)
# Leave blank or omit for public repositories (rate limits will apply)
GITHUB_TOKEN=your_github_personal_access_token_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Internal API URL for Streamlit to connect to FastAPI
API_URL=http://localhost:8000
