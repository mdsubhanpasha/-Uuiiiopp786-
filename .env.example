# OmniRAG-Ops Environment Configuration

# LLM & Embedding Providers
OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Vector DB & Storage Settings
VECTOR_DB_TYPE=faiss  # Options: faiss, chroma, in_memory
EMBEDDING_DIMENSION=384

# Corrective RAG (CRAG) Fallback Settings
CRAG_CONFIDENCE_THRESHOLD=0.65
TAVILY_API_KEY=your_tavily_search_key_here
SERPER_API_KEY=your_serper_api_key_here

# GitHub Repository Deployment
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_NAME=username/omnirag-ops

# LinkedIn Automated Posting
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_id
