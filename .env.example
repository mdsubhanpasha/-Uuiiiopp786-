# CloudNative DevOps Day 3 Environment Configuration

# FastAPI Microservice Configuration
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# GitHub Deployment Automation
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_NAME=devops-day3-cloudnative-pipeline
GITHUB_BRANCH=main

# LinkedIn Automated Posting Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_id
